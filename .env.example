# ============================================================
# MORPHEUS Nebuchadnezzar v1.0 — Environment Variables
# ============================================================

# Frontend (Vite) — aponta para a API no Render
VITE_API_URL=https://morpheus-app-5bmx.onrender.com

# App
VITE_APP_NAME=MORPHEUS
VITE_APP_VERSION=1.0.0

# --- Backend (Render: morpheus-api) ---
# Neon Postgres (obrigatorio para auth)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT (min 16 chars) — use uma string forte e unica
JWT_SECRET=troque-por-segredo-forte-min-32-chars

# Aegis fleet
AEGIS_BASE_URL=https://aegis-control-sand.vercel.app
AEGIS_AGENT_NAME=Morpheus
AEGIS_API_KEY=

# CORS (frontend)
CORS_ORIGIN=https://morpheus-app-six.vercel.app
FRONTEND_URL=https://morpheus-app-six.vercel.app

# LLM keys (opcional)
GROQ_API_KEY=
OPENROUTER_API_KEY=
